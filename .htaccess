Options -Indexes
RewriteEngine On

# Handle Front Controller or clean URLs if needed, otherwise allow standard routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# MIME Types for 3D Assets
AddType model/gltf-binary .glb
AddType model/gltf+json .gltf
AddType model/vnd.usdz+zip .usdz

# CORS headers for 3D model loading across origins if needed
<IfModule mod_headers.c>
    <FilesMatch "\.(glb|gltf|usdz)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>